# Salin ke /etc/waste-bin.env lalu sesuaikan
DEVICE_ID=bin-001
ZONA=lantai-9
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=30
NTP_HOST=id.pool.ntp.org
LOG_LEVEL=INFO
# Opsional: direktori penyimpanan state persisten (default: /var/lib/waste-bin)
# WASTE_BIN_STATE_DIR=/opt/waste-bin/state

# Opsional: port UART per kompartemen sensor (default: /dev/ttyS1, /dev/ttyS2, /dev/ttyS3)
# SENSOR_PORT_1=/dev/ttyS1
# SENSOR_PORT_2=/dev/ttyS2
# SENSOR_PORT_3=/dev/ttyS3

# Opsional: kalibrasi tong dalam mm (default: full=250 mm / 25 cm, empty=700 mm / 70 cm)
# DISTANCE_FULL_MM=250
# DISTANCE_EMPTY_MM=700

# Opsional: aktifkan simulasi dummy sensor (true/false)
# SIMULATE_SENSORS=false
